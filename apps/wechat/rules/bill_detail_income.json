{
  "description": "微信账单详情收入",
  "understanding": [
    "用于微信中带“当前状态”和“收款成功”的单笔收入账单详情页。",
    "收入方向独立于支出规则，商户字段按付款方、付款人或交易对象理解。",
    "金额支持正号、货币符号和“元”三类展示，备注缺失时回退为交易对象。"
  ],
  "rule": {
    "id": "wechat_bill_detail_income_v2",
    "transactionType": "income",
    "requiredAnchors": [
      "当前状态"
    ],
    "anyAnchors": [
      "收款成功"
    ],
    "excludedAnchors": [],
    "amount": {
      "labels": [
        "金额",
        "收款金额",
        "交易金额"
      ],
      "regexes": [
        "^[+＋]?\\s*([0-9]{1,7}(?:\\.[0-9]{1,2})?)$",
        "[¥￥]\\s*([0-9]{1,7}(?:\\.[0-9]{1,2})?)",
        "([0-9]{1,7}(?:\\.[0-9]{1,2})?)\\s*元"
      ],
      "currencyLabels": [
        "¥",
        "￥",
        "人民币"
      ],
      "standaloneRegex": "([0-9]{1,7}(?:\\.[0-9]{1,2})?)"
    },
    "merchant": {
      "labels": [
        "付款方",
        "付款人",
        "交易对象"
      ],
      "beforeAmountNodes": 5
    },
    "note": {
      "fallbackToMerchant": true
    },
    "paymentMethod": {},
    "transactionTime": {
      "labels": [
        "转账时间",
        "收款时间",
        "交易时间"
      ]
    },
    "orderId": {
      "labels": [
        "转账单号",
        "订单号",
        "交易号"
      ]
    }
  }
}
