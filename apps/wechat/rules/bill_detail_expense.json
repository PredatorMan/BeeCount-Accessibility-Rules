{
  "description": "微信账单详情支出",
  "understanding": [
    "用于微信中带“当前状态”的单笔支出账单详情页。",
    "只有出现“支付成功”或“付款成功”时才确认页面，避免把处理中页面当成已完成交易。",
    "金额优先读取带金额标签、货币符号或“元”的节点，并提取商户、付款方式、时间和单号。"
  ],
  "rule": {
    "id": "wechat_bill_detail_expense_v2",
    "transactionType": "expense",
    "requiredAnchors": [
      "当前状态"
    ],
    "anyAnchors": [
      "支付成功",
      "付款成功"
    ],
    "excludedAnchors": [],
    "amount": {
      "labels": [
        "金额",
        "支付金额",
        "付款金额",
        "交易金额"
      ],
      "regexes": [
        "^[-−]\\s*([0-9]{1,7}(?:\\.[0-9]{1,2})?)$",
        "[¥￥]\\s*([0-9]{1,7}(?:\\.[0-9]{1,2})?)",
        "([0-9]{1,7}(?:\\.[0-9]{1,2})?)\\s*元"
      ],
      "currencyLabels": [
        "¥",
        "￥",
        "人民币"
      ],
      "standaloneRegex": "([0-9]{1,7}(?:\\.[0-9]{1,2})?)"
    },
    "merchant": {
      "labels": [
        "商户",
        "商家",
        "收款方",
        "收款人",
        "交易对象"
      ],
      "beforeAmountNodes": 5
    },
    "note": {
      "fallbackToMerchant": true
    },
    "paymentMethod": {
      "labels": [
        "付款方式",
        "支付方式",
        "扣款方式"
      ]
    },
    "transactionTime": {
      "labels": [
        "转账时间",
        "支付时间",
        "付款时间",
        "交易时间"
      ]
    },
    "orderId": {
      "labels": [
        "转账单号",
        "订单号",
        "交易号",
        "商户单号"
      ]
    }
  }
}
