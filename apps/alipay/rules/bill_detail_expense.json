{
  "description": "支付宝成功状态账单详情支出",
  "understanding": [
    "用于仍显示“支付成功”“付款成功”“交易成功”或“扣款成功”的支付宝支出详情页。",
    "必须出现“账单详情”，并通过成功状态文案与历史账单规则区分识别证据。",
    "明确排除待支付、处理中、失败、取消、关闭、退款和支付密码页面。"
  ],
  "rule": {
    "id": "alipay_bill_detail_expense_v2",
    "transactionType": "expense",
    "requiredAnchors": [
      "账单详情"
    ],
    "anyAnchors": [
      "支付成功",
      "付款成功",
      "交易成功",
      "扣款成功"
    ],
    "excludedAnchors": [
      "支付失败",
      "付款失败",
      "交易失败",
      "支付处理中",
      "付款处理中",
      "交易处理中",
      "处理中",
      "等待支付",
      "等待付款",
      "等待买家付款",
      "待支付",
      "待付款",
      "未支付",
      "未付款",
      "支付已取消",
      "付款已取消",
      "已取消",
      "交易关闭",
      "已关闭",
      "退款成功",
      "退款中",
      "退款处理中",
      "已退款",
      "输入支付密码",
      "请输入支付密码",
      "支付密码",
      "验证支付密码",
      "确认付款",
      "立即付款"
    ],
    "amount": {
      "labels": [
        "金额",
        "支付金额",
        "付款金额",
        "交易金额"
      ],
      "regexes": [
        "^[-−]\\s*([0-9]{1,7}(?:\\.[0-9]{1,2})?)$",
        "^支出\\s*[¥￥]?\\s*([0-9]{1,7}(?:\\.[0-9]{1,2})?)\\s*元?$",
        "[¥￥]\\s*([0-9]{1,7}(?:\\.[0-9]{1,2})?)",
        "([0-9]{1,7}(?:\\.[0-9]{1,2})?)\\s*元"
      ],
      "currencyLabels": [
        "¥",
        "￥",
        "人民币"
      ],
      "standaloneRegex": "([0-9]{1,7}(?:\\.[0-9]{1,2})?)"
    },
    "merchant": {
      "labels": [
        "商户",
        "商家",
        "收款方",
        "收款人",
        "交易对象"
      ],
      "beforeAmountNodes": 3
    },
    "note": {
      "labels": [
        "商品说明",
        "收款方备注",
        "付款说明",
        "备注"
      ],
      "fallbackToMerchant": true
    },
    "paymentMethod": {
      "labels": [
        "付款方式",
        "支付方式",
        "扣款方式"
      ]
    },
    "transactionTime": {
      "labels": [
        "支付时间",
        "付款时间",
        "交易时间"
      ]
    },
    "orderId": {
      "labels": [
        "订单号",
        "交易号",
        "商户单号"
      ]
    }
  }
}
