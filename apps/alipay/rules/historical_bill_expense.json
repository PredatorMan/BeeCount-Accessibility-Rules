{
  "description": "支付宝历史账单详情支出",
  "understanding": [
    "用于支付宝已经产生支付记录的历史支出账单详情，不要求页面仍显示“交易成功”。",
    "必须同时出现“账单详情”、支付时间或付款方式等可靠字段，以及完整的“支出 + 金额”节点。",
    "明确排除待支付、处理中、失败、取消、关闭、退款和支付密码页面；“等待确认收货”代表已付款，不排除。"
  ],
  "rule": {
    "id": "alipay_historical_bill_expense_v3",
    "transactionType": "expense",
    "requiredAnchors": [
      "账单详情"
    ],
    "anyAnchors": [
      "支付时间",
      "付款时间",
      "交易时间",
      "付款方式",
      "支付方式",
      "扣款方式",
      "交易详情",
      "订单号",
      "交易号"
    ],
    "excludedAnchors": [
      "支付失败",
      "付款失败",
      "交易失败",
      "支付处理中",
      "付款处理中",
      "交易处理中",
      "处理中",
      "等待支付",
      "等待付款",
      "等待买家付款",
      "待支付",
      "待付款",
      "未支付",
      "未付款",
      "支付已取消",
      "付款已取消",
      "已取消",
      "交易关闭",
      "已关闭",
      "退款成功",
      "退款中",
      "退款处理中",
      "已退款",
      "输入支付密码",
      "请输入支付密码",
      "支付密码",
      "验证支付密码",
      "确认付款",
      "立即付款"
    ],
    "amount": {
      "regexes": [
        "^支出\\s*[¥￥]?\\s*([0-9]{1,7}(?:\\.[0-9]{1,2})?)\\s*元$"
      ]
    },
    "merchant": {
      "labels": [
        "商户",
        "商家",
        "收款方",
        "收款人",
        "交易对象"
      ],
      "beforeAmountNodes": 3
    },
    "note": {
      "labels": [
        "商品说明",
        "收款方备注",
        "付款说明",
        "备注"
      ],
      "fallbackToMerchant": true
    },
    "paymentMethod": {
      "labels": [
        "付款方式",
        "支付方式",
        "扣款方式"
      ]
    },
    "transactionTime": {
      "labels": [
        "支付时间",
        "付款时间",
        "交易时间"
      ]
    },
    "orderId": {
      "labels": [
        "订单号",
        "交易号",
        "商户单号"
      ]
    }
  }
}
