{
  "description": "支付宝历史账单详情收入",
  "understanding": [
    "用于支付宝已经产生收款记录的历史收入账单详情，不依赖“收款成功”文案。",
    "必须同时出现“账单详情”、收款时间或交易号等可靠字段，以及完整的“收入 + 金额”节点。",
    "明确排除待支付、处理中、失败、取消、关闭、退款和支付密码页面，并按付款方提取交易对象。"
  ],
  "rule": {
    "id": "alipay_historical_bill_income_v3",
    "transactionType": "income",
    "requiredAnchors": [
      "账单详情"
    ],
    "anyAnchors": [
      "收款时间",
      "入账时间",
      "到账时间",
      "交易时间",
      "付款方",
      "付款人",
      "交易详情",
      "订单号",
      "交易号"
    ],
    "excludedAnchors": [
      "支付失败",
      "付款失败",
      "交易失败",
      "支付处理中",
      "付款处理中",
      "交易处理中",
      "处理中",
      "等待支付",
      "等待付款",
      "等待买家付款",
      "待支付",
      "待付款",
      "未支付",
      "未付款",
      "支付已取消",
      "付款已取消",
      "已取消",
      "交易关闭",
      "已关闭",
      "退款成功",
      "退款中",
      "退款处理中",
      "已退款",
      "输入支付密码",
      "请输入支付密码",
      "支付密码",
      "验证支付密码",
      "确认付款",
      "立即付款"
    ],
    "amount": {
      "regexes": [
        "^收入\\s*[¥￥]?\\s*([0-9]{1,7}(?:\\.[0-9]{1,2})?)\\s*元$"
      ]
    },
    "merchant": {
      "labels": [
        "付款方",
        "付款人",
        "交易对象"
      ],
      "beforeAmountNodes": 3
    },
    "note": {
      "labels": [
        "商品说明",
        "付款方备注",
        "备注"
      ],
      "fallbackToMerchant": true
    },
    "paymentMethod": {},
    "transactionTime": {
      "labels": [
        "收款时间",
        "入账时间",
        "到账时间",
        "交易时间"
      ]
    },
    "orderId": {
      "labels": [
        "订单号",
        "交易号",
        "商户单号"
      ]
    }
  }
}
